<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    android:background="#2E3035"
    android:elevation="8dp"
    android:orientation="vertical"
    android:padding="16dp"
    android:id="@+id/overlay_root">

    <TextView
        android:id="@+id/tv_caller_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Unknown Caller"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_caller_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="+00 0000 0000"
        android:textColor="#B0B0B0"
        android:textSize="14sp" />
        
    <TextView
        android:id="@+id/tv_caller_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Searching..."
        android:textColor="#888888"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btn_close"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="#FF4B4B"
        android:text="Close Overlay"
        android:textColor="#FFFFFF" />
</LinearLayout>
